# === Backend environment (backend/.env) ===

# Production: use a free Neon PostgreSQL URL, e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.region.aws.neon.tech/textilehub?sslmode=require
DATABASE_URL=sqlite:///./textilehub.db

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# Frontend origin (used for CORS)
FRONTEND_URL=http://localhost:5173

# Public URL of this API (used to build uploaded image URLs)
PUBLIC_BASE_URL=http://localhost:8000

# Hugging Face token — FREE: https://huggingface.co/settings/tokens
# Leave empty for keyword-based fallback; set it to enable the full LLM experience.
HF_TOKEN=

# Optional model overrides
# HF_CHAT_MODEL=HuggingFaceH4/zephyr-7b-beta
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Frontend environment (frontend/.env) ===
# VITE_API_URL=https://textilehub-api.onrender.com
